#!/usr/bin/env bash
set -euo pipefail

# cwm - Cloudflare Worker Manager.
# Creates, deploys, deletes and recreates Cloudflare Workers with wrangler (installed in
# node_modules/ by `npm install`). Each Worker is a wrangler project in workers/<name>/.
#
# Usage:
#   ./cwm create   <name>           Copy the template to workers/<name>/ (if missing), then deploy
#   ./cwm deploy   <name>           Deploy workers/<name>/ (after you edit the code)
#   ./cwm delete   <name>           Delete the Worker on Cloudflare (local code stays)
#   ./cwm recreate <name>           Delete, then deploy again
#   ./cwm list                      List the Workers in the account
#   ./cwm url      <name>           Print the workers.dev URL
#   ./cwm wrangler <name> [args]    Run any wrangler command in workers/<name>/ (dev, tail, ...)
#
# Credentials: the script sources .env/cloudflare-claude-worker-manager.sh (create it with
# ./setup-env.sh). Set CWM_ENV_FILE to use another file.
# Worker code lives in workers/ (gitignored). Set CWM_WORKERS_DIR to use another folder.
# Needs: Node.js 22+, curl and jq.

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly WORKERS_DIR="${CWM_WORKERS_DIR:-$SCRIPT_DIR/workers}"
readonly TEMPLATE_DIR="$SCRIPT_DIR/templates/worker"
readonly WRANGLER="$SCRIPT_DIR/node_modules/.bin/wrangler"
readonly API="https://api.cloudflare.com/client/v4"

die() {
  echo "error: $*" >&2
  exit 1
}

usage() {
  sed -n '4,21p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

load_credentials() {
  local env_file="${CWM_ENV_FILE:-$SCRIPT_DIR/.env/cloudflare-claude-worker-manager.sh}"
  [[ -f "$env_file" ]] || die "credentials file not found: $env_file (run ./setup-env.sh)"
  # shellcheck source=/dev/null
  source "$env_file"
  [[ -n "${CLOUDFLARE_ACCOUNT_ID:-}" ]] || die "CLOUDFLARE_ACCOUNT_ID is not set"
  [[ -n "${CLOUDFLARE_API_TOKEN:-}" ]] || die "CLOUDFLARE_API_TOKEN is not set"
  export CLOUDFLARE_ACCOUNT_ID CLOUDFLARE_API_TOKEN
}

check_dependencies() {
  local tool
  for tool in curl jq node; do
    command -v "$tool" >/dev/null || die "$tool is not installed or not in PATH"
  done
  [[ -x "$WRANGLER" ]] || die "wrangler is not installed. Run: npm install"
}

validate_name() {
  local name="$1"
  [[ "$name" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] ||
    die "invalid name '$name': use 1-63 lowercase letters, digits or dashes"
}

worker_dir() {
  echo "$WORKERS_DIR/$1"
}

require_worker_dir() {
  [[ -f "$(worker_dir "$1")/wrangler.jsonc" ]] ||
    die "workers/$1/wrangler.jsonc not found. Run: ./cwm create $1"
}

# api METHOD PATH -> prints the JSON response; fails if success is false.
api() {
  local method="$1" path="$2" response
  response="$(curl -sS -X "$method" \
    -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
    "$API/accounts/$CLOUDFLARE_ACCOUNT_ID$path")" || die "request failed: $method $path"
  if [[ "$(jq -r '.success' <<<"$response")" != "true" ]]; then
    echo "Cloudflare API error ($method $path):" >&2
    jq -r '.errors[] | "  [\(.code)] \(.message)"' <<<"$response" >&2
    return 1
  fi
  printf '%s\n' "$response"
}

worker_exists() {
  api GET "/workers/scripts" | jq -e --arg n "$1" '.result[] | select(.id == $n)' >/dev/null
}

worker_url() {
  echo "https://$1.$(api GET "/workers/subdomain" | jq -r '.result.subdomain').workers.dev"
}

# run_wrangler NAME [args...] -> runs wrangler inside workers/<name>/.
run_wrangler() {
  local name="$1"
  shift
  (cd "$(worker_dir "$name")" && "$WRANGLER" "$@")
}

scaffold_if_missing() {
  local name="$1" dir
  dir="$(worker_dir "$name")"
  [[ -e "$dir" ]] && return 0
  mkdir -p "$WORKERS_DIR"
  cp -R "$TEMPLATE_DIR" "$dir"
  sed -i.bak "s/__WORKER_NAME__/$name/" "$dir/wrangler.jsonc" && rm "$dir/wrangler.jsonc.bak"
  echo "Created workers/$name/ from the template."
}

cmd_create() {
  scaffold_if_missing "$1"
  cmd_deploy "$1"
}

cmd_deploy() {
  require_worker_dir "$1"
  run_wrangler "$1" deploy
}

cmd_delete() {
  local name="$1"
  if ! worker_exists "$name"; then
    echo "Worker '$name' does not exist on Cloudflare. Nothing to delete."
    return 0
  fi
  echo "Deleting Worker '$name'..."
  # CI=true and closed stdin: wrangler skips its "Are you sure?" question, also in a
  # real terminal. Running from SCRIPT_DIR means the delete does not need the local folder.
  local output
  if output="$(cd "$SCRIPT_DIR" && CI=true "$WRANGLER" delete "$name" </dev/null 2>&1)"; then
    echo "Deleted."
  elif worker_exists "$name"; then
    printf '%s\n' "$output" >&2
    die "wrangler could not delete '$name'"
  else
    # After the delete, wrangler lists KV namespaces to clean up old Workers Sites
    # assets. Without a KV permission that step fails, but the Worker is gone.
    echo "Deleted. (wrangler's KV cleanup step failed because the token has no"
    echo "'Workers KV Storage: Read' permission. You can ignore this.)"
  fi
  echo "Local code stays in workers/$name/."
}

cmd_recreate() {
  require_worker_dir "$1"
  cmd_delete "$1"
  cmd_deploy "$1"
}

cmd_list() {
  local response
  response="$(api GET "/workers/scripts")"
  if [[ "$(jq '.result | length' <<<"$response")" -eq 0 ]]; then
    echo "No Workers in this account."
    return 0
  fi
  jq -r '.result[] | "\(.id)\t(modified \(.modified_on))"' <<<"$response"
}

main() {
  local command="${1:-help}"
  local name="${2:-}"

  case "$command" in
    help | -h | --help)
      usage
      return 0
      ;;
  esac

  check_dependencies
  load_credentials

  case "$command" in
    list)
      cmd_list
      ;;
    create | deploy | delete | recreate | url | wrangler)
      [[ -n "$name" ]] || die "missing <name>. Run: ./cwm help"
      validate_name "$name"
      case "$command" in
        create) cmd_create "$name" ;;
        deploy) cmd_deploy "$name" ;;
        delete) cmd_delete "$name" ;;
        recreate) cmd_recreate "$name" ;;
        url) worker_url "$name" ;;
        wrangler)
          require_worker_dir "$name"
          shift 2
          run_wrangler "$name" "$@"
          ;;
      esac
      ;;
    *)
      die "unknown command '$command'. Run: ./cwm help"
      ;;
  esac
}

main "$@"
